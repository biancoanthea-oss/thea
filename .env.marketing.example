# Copy to .env.marketing and fill in. NEVER commit the filled-in file.
# See marketing/mcp-setup.md for where each value comes from.

# --- Google Ads MCP (read-only, official server) ---
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_ADS_DEVELOPER_TOKEN=from-manager-account-api-center
# Manager (MCC) account id, digits only, no dashes. Omit if not using a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Path to OAuth client secrets or service-account JSON, or leave unset if using
# `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-ads-credentials.json

# --- Google Search Console MCP (community server) ---
GSC_CREDENTIALS_PATH=/absolute/path/to/gsc-service-account.json
