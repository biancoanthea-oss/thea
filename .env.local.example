# Optional — enables the ✨ AI writing helpers (Improve / Formal / Shorten /
# Expand / Tailor / AI draft). The app works fully without this; AI features
# just stay switched off until a key is present.
#
# 1. Copy this file to .env.local
# 2. Paste your Anthropic API key below
# 3. Restart the dev server
#
# Get a key at https://console.anthropic.com

ANTHROPIC_API_KEY=
