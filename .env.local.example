# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the real values.
# In Vercel, add the SAME variables under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Supabase → Project Settings → API) ---

# Public — safe to expose to the browser. Used by guests to upload.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. NEVER expose this to the browser.
# Used by the gallery/slideshow/guestbook pages to list media/messages.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional personalisation ---
# Couple names shown in headings (defaults to "Sarah & Lairkin").
NEXT_PUBLIC_COUPLE_NAME=Sarah & Lairkin

# Optional: cap per-file upload size in megabytes to stay within the
# Supabase free tier. Leave blank for no client-side cap.
NEXT_PUBLIC_MAX_UPLOAD_MB=

# --- SEO / link sharing (all optional) ---
# Canonical absolute URL of the deployed site (no trailing slash). Powers the
# Open Graph / Twitter share-preview card and robots.txt. On Vercel this is
# auto-detected from VERCEL_PROJECT_PRODUCTION_URL, so you can leave it blank.
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Link-preview image (1200×630 recommended). Defaults to /og.png — drop a file
# at public/og.png, or point this at any absolute image URL.
NEXT_PUBLIC_OG_IMAGE=

# Search-engine indexing. A wedding gallery is PRIVATE by default: guests'
# photos & messages are kept out of Google (noindex + robots.txt Disallow).
# Set to "true" ONLY if you want the site publicly discoverable in search.
NEXT_PUBLIC_ALLOW_INDEXING=false
