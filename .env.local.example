# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the real value.
# In Vercel, add the SAME variable under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# Your Anthropic API key (https://console.anthropic.com/ → API Keys).
# SECRET — server-side only. It powers the recipe → shopping-list extraction
# and is never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
