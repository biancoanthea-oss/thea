# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the real values.
# In Vercel, add the SAME variables under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Supabase → Project Settings → API) ---
# Powers the CRM (contacts, deals, activities) and saved SEO audit history.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. NEVER expose this to the browser.
# All CRM/SEO API routes read & write through this key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional ---
# App name shown in the nav and page titles.
NEXT_PUBLIC_APP_NAME=Free Marketing Suite

# Google PageSpeed Insights API key (optional). The SEO auditor's
# "Core Web Vitals" enrichment works without one but is rate-limited;
# a free key raises the limit. Get one at:
#   https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
