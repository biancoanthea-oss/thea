# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the real values.
# In Vercel, add the SAME variables under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Supabase → Project Settings → API) ---

# Public — safe to expose to the browser. Used by guests to upload.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. NEVER expose this to the browser.
# Used by the gallery/slideshow/guestbook pages to list media/messages.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional personalisation ---
# Couple names shown in headings (defaults to "Sarah & Lairkin").
NEXT_PUBLIC_COUPLE_NAME=Sarah & Lairkin

# Optional: cap per-file upload size in megabytes to stay within the
# Supabase free tier. Leave blank for no client-side cap.
NEXT_PUBLIC_MAX_UPLOAD_MB=
