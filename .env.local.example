# ─────────────────────────────────────────────────────────────
# Copy this file to ".env.local" and fill in the real values.
# In Vercel, add the SAME variables under
#   Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# --- Supabase (from Supabase → Project Settings → API) ---

# Public — safe to expose to the browser. Used by guests to upload.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-side only. NEVER expose this to the browser.
# Used by the gallery/slideshow/guestbook pages to list media/messages.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional personalisation ---
# Couple names shown in headings (defaults to "Sarah & Lairkin").
NEXT_PUBLIC_COUPLE_NAME=Sarah & Lairkin

# Optional: cap per-file upload size in megabytes to stay within the
# Supabase free tier. Leave blank for no client-side cap.
NEXT_PUBLIC_MAX_UPLOAD_MB=

# --- Time-capsule letters (optional feature) ---
# Guests write a letter on "/" and it is emailed back to them on the date
# they chose (one year later by default). Requires all three values below;
# without them the letters still get saved, they just won't be emailed.

# API key from https://resend.com (free tier is plenty).
RESEND_API_KEY=

# The "from" address for delivered letters. Must be a sender verified in
# Resend (e.g. "Sarah & Lairkin <letters@yourdomain.com>").
LETTER_FROM_EMAIL=

# Any long random string. Vercel sends it with each cron invocation so only
# the cron can trigger deliveries. Generate one with: openssl rand -hex 32
CRON_SECRET=
