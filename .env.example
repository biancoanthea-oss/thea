# ─── Stacked Marketing Hub — server config ───────────────────────────────────
# Copy this file to ".env" and fill it in. This file is READ ONLY BY THE SERVER.
# Nothing here is ever sent to the browser.

# Port the Express API listens on (the React dev server proxies /api to it).
PORT=4000

# Where the SQLite database file lives. Default is fine for local use.
DATABASE_FILE=./server/data/marketing-hub.sqlite

# ─── Google APIs (optional — leave blank to use manual entry only) ───────────
# We authenticate with a Google *service account*. Point this at the JSON key
# file you download from Google Cloud (see README → "Google Cloud setup").
# Give an ABSOLUTE path, or a path relative to the project root.
# Leave it commented out until you've done the Google Cloud setup — the app
# runs fine on manual entry without it.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Alternatively, paste the whole JSON key on one line instead of a file path.
# (Use this OR GOOGLE_APPLICATION_CREDENTIALS, not both.)
# GOOGLE_CREDENTIALS_JSON=
